# ==========================================================================
# Application
# ==========================================================================
NODE_ENV=development
# Porta HTTP usada apenas pelo endpoint de health-check (/health).
PORT=3001

# ==========================================================================
# AWS credentials & region
# ==========================================================================
AWS_REGION=us-east-1
# Credenciais dummy do LocalStack (qualquer valor é aceito).
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ==========================================================================
# AWS / LocalStack — endpoint dos serviços AWS emulados (SQS, S3)
# ==========================================================================
# Dev no host use localhost; dentro do compose é sobrescrito para http://localstack:4566.
AWS_ENDPOINT=http://localhost:4566

# ==========================================================================
# SQS — fila de entrada dos jobs de processamento de vídeo
# ==========================================================================
SQS_QUEUE_URL=http://localhost:4566/000000000000/video-processing

# ==========================================================================
# S3 — bucket de origem (vídeos) e destino (zips de frames)
# ==========================================================================
S3_BUCKET_NAME=hackathon-videos

# ==========================================================================
# Core API — recebe as atualizações de status (PATCH /internal/videos/:id/status)
# ==========================================================================
# dev no host: localhost:3000 | compose: sobrescrito para o container do core.
API_URL=http://localhost:3000
# DEVE ser idêntico ao INTERNAL_API_TOKEN do .env do core.
INTERNAL_API_TOKEN=change-me-internal-token
